# Every database is a named environment. Names: lowercase letters, digits and _.
# Pick source and target at run time (menu, or --from / --to).
MIGRATOR_ENVS=creative,live

# Optional: preselected in the menu (Enter accepts)
MIGRATOR_DEFAULT_FROM=creative
MIGRATOR_DEFAULT_TO=live

# Optional
DB_CONNECT_TIMEOUT=10

# Source: creative / staging server (needs SELECT)
ENV_CREATIVE_LABEL=Creative
ENV_CREATIVE_HOST=127.0.0.1
ENV_CREATIVE_PORT=3306
ENV_CREATIVE_USER=migrator_ro
ENV_CREATIVE_PASSWORD=change-me
ENV_CREATIVE_NAME=creative
ENV_CREATIVE_PROTECTED=0

# Target: live / production server (needs SELECT and INSERT only)
# PROTECTED=1: a real migration into it asks you to type its name first.
ENV_LIVE_LABEL=Live
ENV_LIVE_HOST=127.0.0.1
ENV_LIVE_PORT=3306
ENV_LIVE_USER=migrator_insert
ENV_LIVE_PASSWORD=change-me
ENV_LIVE_NAME=live
ENV_LIVE_PROTECTED=1
